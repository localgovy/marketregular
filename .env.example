NEXT_PUBLIC_SITE_URL=https://www.marketregular.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails that are promoted to admin on first sign-in
ADMIN_EMAILS=you@marketregular.com

# Optional. HTML-tag token from Search Console (URL-prefix property).
# Prefer a Domain property verified with a DNS TXT record at NamesLink.
GOOGLE_SITE_VERIFICATION=
