NEXT_PUBLIC_SITE_URL=https://www.marketregular.com

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only copies. Required on Vercel for Finish, week-plan mail, and admin.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin access is profiles.role = 'admin' in the database (SQL/dashboard).
# Visiting /admin does not promote anyone.

# Optional. Stripe for stall checkout. Use a restricted key (rk_) in production, stored as a
# sensitive environment variable. The platform account is the LOCALGOVY sole proprietorship.
# The webhook endpoint is /api/stripe/webhook. Use both signing secrets: one for
# events on your account (stall fees) and one for connected accounts (stall charges).
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET=

# Optional. HTML-tag token from Search Console (URL-prefix property).
# Prefer a Domain property verified with a DNS TXT record at NamesLink.
GOOGLE_SITE_VERIFICATION=

# Optional. Google OAuth Web client ID for Continue with Google (server can
# also resolve it from the Supabase authorize URL if omitted).
# GOOGLE_OAUTH_CLIENT_ID=

# Visit-plan email (Resend). Verify marketregular.com in Resend (DKIM CNAMEs, not MX)
# or mail only delivers to the Resend account owner.
# RESEND_API_KEY=
# RESEND_FROM=MarketRegular <hello@marketregular.com>

# Admin decrypts stall passwords with this key. 32 bytes, base64. The same value
# has to be set locally and on Vercel or the stall page cannot show the password.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# VENDOR_PASSWORD_KEY=
